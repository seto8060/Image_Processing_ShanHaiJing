[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[project]
name = "rainnet_harmonizer"
version = "0.1.0"
description = "High-resolution Image Harmonization using RainNet and Guided Filtering"
readme = "README.md"
requires-python = ">=3.7"
authors = [
  { name="ArisWSi", email="No Need" },
]
dependencies = [
    "torch>=1.7.0",
    "torchvision>=0.8.0",
    "numpy",
    "opencv-python",  
    "Pillow"
]

[tool.setuptools.packages.find]
where = ["src"]